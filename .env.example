APP_NAME=Gatepass
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Local host configuration
PLATFORM_DATABASE_URL=mysql+aiomysql://gatepass:gatepass@localhost:3306/gatepass_platform
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=1800

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# If running with docker compose, use this instead:
# PLATFORM_DATABASE_URL=mysql+aiomysql://gatepass:gatepass@mysql:3306/gatepass_platform
